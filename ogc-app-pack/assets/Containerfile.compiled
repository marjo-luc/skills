# Compiled binary entrypoint -- compile at build time onto PATH.
# COPY paths are relative to the REPO ROOT -- the Action builds with context: .
FROM gcc:14

COPY ./ALGORITHM_DIR/SOURCE.f90 /app/SOURCE.f90

RUN gfortran -O2 -o /usr/local/bin/BINARY /app/SOURCE.f90

# run_command: BINARY
# The program parses `--flag value` pairs itself and must `mkdir -p output`
# before writing results there.
