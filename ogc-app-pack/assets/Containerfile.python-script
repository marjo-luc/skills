# Python script entrypoint.
# COPY paths are relative to the REPO ROOT -- the Action builds with context: .
FROM python:3.12-slim

# Drop these two lines if the script has no third-party dependencies.
COPY ./ALGORITHM_DIR/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY ./ALGORITHM_DIR/SCRIPT.py /usr/local/bin/SCRIPT.py

RUN chmod +x /usr/local/bin/SCRIPT.py

# No CMD/ENTRYPOINT: CWL supplies baseCommand plus the bound --flag value args.
# run_command: SCRIPT.py    (resolves on PATH; needs a #!/usr/bin/env python3 shebang)
